# Browser-facing HTTPS origin. The existing reverse proxy terminates TLS.
APP_ORIGIN=https://calendar.example.net
HOST=0.0.0.0
PORT=6742

# Final authenticated CalDAV endpoint; no credentials in this URL.
CALDAV_URL=https://dav.example.net/
# Include principal/home paths if they are outside the endpoint's path.
CALDAV_ALLOWED_PATHS=/
# Explicit opt-in only for a trusted private-network HTTP upstream.
CALDAV_ALLOW_HTTP=false

SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8
MAX_SESSIONS=100
UPSTREAM_TIMEOUT_MS=15000
# Limits per client IP. Forwarded addresses are ignored unless its proxy is trusted.
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_LOGINS=10
# Comma-separated proxy IPs/CIDRs; leave empty for direct connections.
# Use only your proxy's address/network, and prevent direct access to the app.
TRUSTED_PROXIES=
# For a private HTTPS certificate authority, provide a PEM file:
# NODE_EXTRA_CA_CERTS=/run/certificates/dav-ca.pem
